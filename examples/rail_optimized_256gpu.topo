// Rail-optimized single-plane spine-leaf tree.
// 32 nodes x 8 GPUs = 256 GPUs, 8 leaf switches, 4 spine switches.
// Switches are 64 x 400Gbps ports; at 2:1 neither tier fills the part.
//
// Port budget per leaf:  32 down (1 GPU rail from each of the 32 nodes)
//                      + 16 up   (4 spines x 4 ports each) = 48 of 64 ports.
// Port budget per spine: 8 leaves x 4 ports = 32 of 64 ports.
//
// Rail-optimized: leaf l attaches to GPU l of every node, so each of the 8
// GPUs in a node lands on a distinct leaf (rail).
//
// Leaf-spine bandwidth, 2:1 OVERSUBSCRIBED: a leaf's 32 downlinks x 400Gbps =
// 12800Gbps aggregate, but only 6400Gbps of uplink, split evenly over the 4
// spines -> 1600Gbps per leaf-spine edge. This matches the taper of the
// dual-plane rail_optimized_256gpu_dual_plane.topo, so the two differ only in
// the per-GPU rail count and the plane isolation, not in the fabric cut ratio.
// Each edge is cabled as 4 parallel 400Gbps links rather than declared as one
// 1600Gbps link: the solver sees the same 1600Gbps aggregate either way, but
// the cable count reaches Topology.ports, so the post-solve packing
// (teccl/ncclize/port_split.py) pins each flow to one 400Gbps cable instead of
// letting it spread across the whole bundle.

// Latency is a uniform 700 ns on every link. The Python classes these files port give
// intra-host links a shorter alpha (0.35 us), but no result here turns on it -- the
// binding constraints are all capacity cuts -- so the files keep one value throughout.
// One node: 8 GPUs fully served by a single NVSwitch at 1800 GBps per GPU.

module server() {
    node nvsw type=nvswitch;
    for g in (0, 7) {
        node gpu{g} type=gpu;
        link gpu{g} nvsw bandwidth=1800[GBps] latency=700[ns];
    }
}

module main() {
    rdma L2AckInterval=0 L2ChunkSize=4000 Mtu=4096 CcMode=12;
    // 32 nodes.
    for s in (0, 31) {
        use server() as srv{s} cell;
    }

    // 8 leaf switches, 4 spine switches.
    for l in (0, 7) {
        node leaf{l} type=switch;
    }
    for p in (0, 3) {
        node spine{p} type=switch;
    }

    // Rail-optimized leaf-GPU links: leaf l <- GPU l of every node.
    // 8 leaves x 32 nodes = 256 links, one 400Gbps rail per GPU.
    for l in (0, 7) {
        for s in (0, 31) {
            link leaf{l} srv{s}.gpu{l} bandwidth=400[Gbps] latency=700[ns];
        }
    }

    // Fully-connected leaf-spine mesh. Each leaf-spine pair is one bundle of
    // 4 x 400Gbps = 1600Gbps (4 ports on each side), cabled as 4 parallel links
    // rather than one fat 1600Gbps link (see header).
    for l in (0, 7) {
        for p in (0, 3) {
            for c in (0, 3) {
                link leaf{l} spine{p} bandwidth=400[Gbps] latency=700[ns];
            }
        }
    }
}
