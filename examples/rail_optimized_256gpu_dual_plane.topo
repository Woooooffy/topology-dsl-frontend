// Rail-optimized DUAL-PLANE spine-leaf tree.
// 32 nodes x 8 GPUs = 256 GPUs, 8 leaf switches, 4 spine switches -- same node, leaf and
// spine counts as rail_optimized_256gpu.topo, but split into two isolated fabrics per
// https://docs.nvidia.com/enterprise-reference-architectures/hgx-ai-factory/latest/network-logical-architecture.html
// ("GPU Compute (East/West) Network uses separate, isolated dual-plane leaf-spine
// architecture ... dual-plane rail-optimized, non-blocking Spectrum fabric with 64-port
// switches ... 4 leaf switches per plane, each supporting 2 rails (1+5, 2+6, 3+7, 4+8) ...
// each GPU has an individual 400Gb connection to each plane via an 800Gb port broken out
// to 2x400Gb").
//
// Plane A = leafA0-3 + spineA0-1. Plane B = leafB0-3 + spineB0-1 (mirror, fully isolated
// from plane A -- no link crosses planes). Each of the 4 leaves in a plane carries 2 rails
// (0-indexed: leaf0 <- gpu0,gpu4; leaf1 <- gpu1,gpu5; leaf2 <- gpu2,gpu6; leaf3 <- gpu3,gpu7),
// matching the doc's "1+5, 2+6, 3+7, 4+8" pairing.
//
// Every GPU's 800Gbps port is broken out into 2x400Gbps: one 400Gbps rail into its plane-A
// leaf, one 400Gbps rail into its plane-B leaf -- so each GPU is dual-homed across the two
// otherwise-isolated planes, doubling its total NIC bandwidth vs. the single-plane topology
// while keeping the per-plane rail bandwidth (400Gbps) identical to it. Port breakout is
// what lets a 64-port leaf carry 2 rails x 32 nodes = 64 downlinks in a single plane.
//
// Leaf-spine bandwidth (non-blocking, per plane): a leaf's 64 downlinks x 400Gbps = 25600Gbps
// aggregate, split evenly over the plane's 2 spines -> 12800Gbps per leaf-spine link.
//
// Latency is a uniform 700 ns on every fabric link, matching rail_optimized_256gpu.topo.
// One node: 8 GPUs fully served by a single NVSwitch at 1800 GBps per GPU.

module server() {
    node nvsw type=nvswitch;
    for g in (0, 7) {
        node gpu{g} type=gpu;
        link gpu{g} nvsw bandwidth=1800[GBps] latency=700[ns];
    }
}

module main() {
    rdma L2AckInterval=0 L2ChunkSize=4000 Mtu=4096 CcMode=12;
    // 32 nodes.
    for s in (0, 31) {
        use server() as srv{s} cell;
    }

    // 4 leaf switches per plane (8 total), 2 spine switches per plane (4 total).
    for l in (0, 3) {
        node leafA{l} type=switch;
        node leafB{l} type=switch;
    }
    for p in (0, 1) {
        node spineA{p} type=switch;
        node spineB{p} type=switch;
    }

    // Rail-to-leaf mapping, mirrored identically in both planes: leaf l <- rails {l, l+4}
    // of every node. Each GPU's broken-out port lands one 400Gbps rail on plane A and one
    // 400Gbps rail on plane B.
    for s in (0, 31) {
        link leafA0 srv{s}.gpu0 bandwidth=400[Gbps] latency=700[ns];
        link leafA0 srv{s}.gpu4 bandwidth=400[Gbps] latency=700[ns];
        link leafA1 srv{s}.gpu1 bandwidth=400[Gbps] latency=700[ns];
        link leafA1 srv{s}.gpu5 bandwidth=400[Gbps] latency=700[ns];
        link leafA2 srv{s}.gpu2 bandwidth=400[Gbps] latency=700[ns];
        link leafA2 srv{s}.gpu6 bandwidth=400[Gbps] latency=700[ns];
        link leafA3 srv{s}.gpu3 bandwidth=400[Gbps] latency=700[ns];
        link leafA3 srv{s}.gpu7 bandwidth=400[Gbps] latency=700[ns];

        link leafB0 srv{s}.gpu0 bandwidth=400[Gbps] latency=700[ns];
        link leafB0 srv{s}.gpu4 bandwidth=400[Gbps] latency=700[ns];
        link leafB1 srv{s}.gpu1 bandwidth=400[Gbps] latency=700[ns];
        link leafB1 srv{s}.gpu5 bandwidth=400[Gbps] latency=700[ns];
        link leafB2 srv{s}.gpu2 bandwidth=400[Gbps] latency=700[ns];
        link leafB2 srv{s}.gpu6 bandwidth=400[Gbps] latency=700[ns];
        link leafB3 srv{s}.gpu3 bandwidth=400[Gbps] latency=700[ns];
        link leafB3 srv{s}.gpu7 bandwidth=400[Gbps] latency=700[ns];
    }

    // Fully-connected leaf-spine mesh, isolated per plane.
    for l in (0, 3) {
        for p in (0, 1) {
            link leafA{l} spineA{p} bandwidth=12800[Gbps] latency=700[ns];
            link leafB{l} spineB{p} bandwidth=12800[Gbps] latency=700[ns];
        }
    }
}
