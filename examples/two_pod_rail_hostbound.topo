// Port of TE-CCL's TwoPodRailHostBound (teccl/topologies/two_pod_rail.py):
// the RATE configuration of the 16-GPU / 8-node / 2-pod rail-optimized topology.
//
// 8 nodes x 2 GPUs = 16 GPUs, 8 NVSwitches, 4 leaf switches, 2 spine switches (30 nodes).
//   Pod A = srv0-srv3, Pod B = srv4-srv7. Each node holds 2 GPUs behind one NVSwitch.
//   Leaf(pod p, rail r) serves the rail-r GPU of every node in pod p -> 4 leaves:
//     leaf0 = (podA, rail0)  leaf1 = (podA, rail1)  leaf2 = (podB, rail0)  leaf3 = (podB, rail1)
//   Every leaf reaches BOTH spines, so cross-pod traffic must cross a spine.
//
// Bandwidths (GB/s, straight from the Python class):
//   NVLINK_BW     = 900          GPU <-> its NVSwitch
//   GPU_LEAF_BW   = 25           <- the host-bound knob (TwoPodRailHostBound.GPU_LEAF_BW)
//   LEAF_SPINE_BW = (50, 25)     deliberately UNEQUAL, per spine
// Latencies: NVLINK_ALPHA = 0.35us = 350ns, NETWORK_ALPHA = 0.7us = 700ns.
//
// Host-bound means the GPU->leaf link is the binding cut, and both streams on it are
// pinned with zero slack, so a rate-oblivious emitter cannot hide in headroom.

// One node: 2 GPUs fully served by a single NVSwitch at 900 GBps per GPU.
module server() {
    node nvsw type=nvswitch;
    for g in (0, 1) {
        node gpu{g} type=gpu;
        link gpu{g} nvsw bandwidth=900[GBps] latency=350[ns];
    }
}

module main() {
    rdma L2AckInterval=0 L2ChunkSize=4000 Mtu=4096 CcMode=12;

    // 8 nodes: srv0-srv3 in pod A, srv4-srv7 in pod B.
    for s in (0, 7) {
        use server() as srv{s};
    }

    // 4 leaf switches (pod x rail), 2 spine switches.
    for l in (0, 3) {
        node leaf{l} type=switch;
    }
    for p in (0, 1) {
        node spine{p} type=switch;
    }

    // Rail-optimized downlinks: GPU(n, r) reaches ONLY leaf(pod(n), r).
    // Pod A -> leaf0 (rail 0) / leaf1 (rail 1).
    for s in (0, 3) {
        link leaf0 srv{s}.gpu0 bandwidth=25[GBps] latency=700[ns];
        link leaf1 srv{s}.gpu1 bandwidth=25[GBps] latency=700[ns];
    }
    // Pod B -> leaf2 (rail 0) / leaf3 (rail 1).
    for s in (4, 7) {
        link leaf2 srv{s}.gpu0 bandwidth=25[GBps] latency=700[ns];
        link leaf3 srv{s}.gpu1 bandwidth=25[GBps] latency=700[ns];
    }

    // Leaf-spine full mesh with per-spine capacity: spine0 at 50 GBps, spine1 at 25 GBps.
    for l in (0, 3) {
        link leaf{l} spine0 bandwidth=50[GBps] latency=700[ns];
        link leaf{l} spine1 bandwidth=25[GBps] latency=700[ns];
    }
}
