// One pod of a k-ary fat tree, but with a single aggregation switch instead
// of k/2, so all edge switches uplink into one top-level switch and create
// real incast there.
// k/2 edge switches, 1 aggregation switch, k/2 GPUs per edge switch.
// All links are 400 Gbps / 700 ns.

module rack(k) {
    node sw type=switch;
    for h in (1, k / 2) {
        node gpu{h} type=gpu;
        link sw gpu{h} bandwidth=400[Gbps] latency=700[ns];
    }
}

module pod(k) {
    for j in (1, k / 2) {
        use rack(k) as esw{j};
    }
    node asw type=switch;
    for j in (1, k / 2) {
        link esw{j}.sw asw bandwidth=400[Gbps] latency=700[ns];
    }
}

module main() {
	rdma L2AckInterval=0 L2ChunkSize=4000 Mtu=1500 CcMode=12;
    use pod(4) as p;
}
