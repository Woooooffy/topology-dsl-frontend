// Port of TE-CCL's TwoPodRailHostBound *with its LEAF_SPINE_PORTS = (2, 1) cabling made
// explicit* (teccl/topologies/two_pod_rail.py): the RATE configuration of the 16-GPU /
// 8-node / 2-pod rail-optimized topology, where each leaf<->spine0 link is TWO 25 GBps
// cables instead of one 50 GBps cable.
//
// This is the only difference from two_pod_rail_hostbound.topo. In TE-CCL the split is
// invisible to the solver (capacity[leaf][spine0] is still 50 GB/s), so every route and
// every schedule is unchanged; what it changes is the PORT numbering of the emitted
// forwarding table -- and here, in ns-3, it also makes each cable a real, separately
// queued 25 GBps device rather than one 50 GBps pipe.
//
// 8 nodes x 2 GPUs = 16 GPUs, 8 NVSwitches, 4 leaf switches, 2 spine switches (30 nodes).
//   Pod A = srv0-srv3, Pod B = srv4-srv7. Each node holds 2 GPUs behind one NVSwitch.
//   Leaf(pod p, rail r) serves the rail-r GPU of every node in pod p -> 4 leaves:
//     leaf0 = (podA, rail0)  leaf1 = (podA, rail1)  leaf2 = (podB, rail0)  leaf3 = (podB, rail1)
//   Every leaf reaches BOTH spines, so cross-pod traffic must cross a spine.
//
// Bandwidths (GB/s, straight from the Python class):
//   NVLINK_BW     = 900          GPU <-> its NVSwitch
//   GPU_LEAF_BW   = 25           <- the host-bound knob (TwoPodRailHostBound.GPU_LEAF_BW)
//   LEAF_SPINE_BW = (50, 25)     deliberately UNEQUAL, per spine
//   LEAF_SPINE_PORTS = (2, 1)    spine0's 50 = 2 x 25 cables, spine1's 25 = 1 cable
// Every port in the fabric is therefore 25 GBps, and each leaf still has 75 GB/s of uplink.
// Latencies: NVLINK_ALPHA = 0.35us = 350ns, NETWORK_ALPHA = 0.7us = 700ns.
//
// PORT BUDGET (SWITCH_RADIX = 8), matching TwoPodRailHostBound's docstring table. TE-CCL
// numbers a switch's ports positionally over its neighbors in ascending node index, then
// over that link's cables (Topology.port_order); node indices are
// GPU(n,r) = 2n+r, NVSwitch(n) = 16+n, Leaf(p,r) = 24+2p+r, Spine(s) = 28+s. The link
// statements below are written in exactly that order, so ns-3's per-node device index
// lands on the same port number:
//
//   leaf(pod p, rail r)  port 0-3   the 4 GPU downlinks, one per node of pod p on rail r
//                        port 4-5   the 2 cables to spine0
//                        port 6     the 1 cable to spine1        (7 of 8 used)
//   spine0               port 0-7   4 leaves x 2 cables, leaf-major   (8 of 8 -- exactly full)
//   spine1               port 0-3   4 leaves x 1 cable                (4 of 8 used)
//
// Host-bound means the GPU->leaf link is the binding cut, and both streams on it are
// pinned with zero slack, so a rate-oblivious emitter cannot hide in headroom.

// One node: 2 GPUs fully served by a single NVSwitch at 900 GBps per GPU.
module server() {
    node nvsw type=nvswitch;
    for g in (0, 1) {
        node gpu{g} type=gpu;
        link gpu{g} nvsw bandwidth=900[GBps] latency=350[ns];
    }
}

module main() {
    rdma L2AckInterval=0 L2ChunkSize=4000 Mtu=4096 CcMode=12;

    // 8 nodes: srv0-srv3 in pod A, srv4-srv7 in pod B.
    for s in (0, 7) {
        use server() as srv{s};
    }

    // 4 leaf switches (pod x rail), 2 spine switches.
    for l in (0, 3) {
        node leaf{l} type=switch;
    }
    for p in (0, 1) {
        node spine{p} type=switch;
    }

    // Rail-optimized downlinks: GPU(n, r) reaches ONLY leaf(pod(n), r).
    // Ascending node index within each leaf => leaf ports 0-3.
    // Pod A -> leaf0 (rail 0) / leaf1 (rail 1).
    for s in (0, 3) {
        link leaf0 srv{s}.gpu0 bandwidth=25[GBps] latency=700[ns];
        link leaf1 srv{s}.gpu1 bandwidth=25[GBps] latency=700[ns];
    }
    // Pod B -> leaf2 (rail 0) / leaf3 (rail 1).
    for s in (4, 7) {
        link leaf2 srv{s}.gpu0 bandwidth=25[GBps] latency=700[ns];
        link leaf3 srv{s}.gpu1 bandwidth=25[GBps] latency=700[ns];
    }

    // Leaf-spine mesh. spine0's 50 GBps is TWO 25 GBps cables (leaf ports 4 and 5),
    // spine1's 25 GBps is one (leaf port 6). Emitting both spine0 cables before the
    // spine1 cable, and looping leaves in ascending order, reproduces TE-CCL's
    // leaf-major cable numbering on spine0 (leaf0 c0, leaf0 c1, leaf1 c0, ...).
    for l in (0, 3) {
        link leaf{l} spine0 bandwidth=25[GBps] latency=700[ns];
        link leaf{l} spine0 bandwidth=25[GBps] latency=700[ns];
        link leaf{l} spine1 bandwidth=25[GBps] latency=700[ns];
    }
}
