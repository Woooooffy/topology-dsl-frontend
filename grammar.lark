start: module+ //needs at least a module

// module
module: "module" NAME "(" [params] ")" "{" stmt* "}"
params: NAME ("," NAME)*

// stmt
stmt:  node_stmt ";"
    | link_stmt ";"
    | use_stmt ";"
    | rdma_stmt ";"
    | sym_stmt ";"
    | for_stmt
		| if_stmt

// ----------------- NODE -----------------
node_stmt: "node" name attr*

// supports h{i}
name: NAME template_suffix?
template_suffix: var | "{" NUMBER "}"


// ----------------- SYMMETRY -----------------
// "symmetric spine0 spine1;" declares the listed nodes INTERCHANGEABLE: swapping them maps the
// topology onto itself. It states an intent the graph alone cannot -- two nodes can look alike
// by accident -- and a consumer that exploits symmetry (a solver breaking a degenerate tie) uses
// it; one that does not (ns-3) ignores it. It adds no node and no link.
sym_stmt: "symmetric" ref ref+

// ----------------- LINK -----------------
link_stmt: "link" ref ref (attr)*

// supports c1.sw or h{i}
ref: name ("." name)*


// ----------------- USE -----------------
// The optional `cell` marker declares this instance a HIERARCHY CELL: the group of nodes that a
// hierarchical consumer collapses into one coarse node (a host, a rack). It is pure structure --
// it adds no node, link or attribute -- so a backend with no notion of hierarchy (ns-3) ignores
// it. Markers nest: a marked instance inside a marked instance is the outer one's subcell.
use_stmt: "use" name "(" [args] ")" "as" name [cell_marker]
cell_marker: "cell"


// ----------------- RDMA CONFIG -----------------
// uniform RdmaHw attributes applied to every GPU's RdmaHw instance (e.g.
// "rdma L2AckInterval=1 L2ChunkSize=4000 Mtu=1500 CcMode=12;"), as opposed
// to per-link attrs which vary per device
rdma_stmt: "rdma" attr*

args: value ("," value)*


// ----------------- FOR LOOP -----------------
for_stmt: "for" name "in" "(" value "," value ")" "{" stmt* "}"

// ------------- If Statement -------------
if_stmt: "if" "(" condition ")" "{" stmt* "}"

// ------------- Conditions -------------
condition: value COMP_OP value

COMP_OP: "==" | "!=" | "<" | "<=" | ">" | ">="

// ----------------- ATTRIBUTES -----------------
attr: NAME "=" value


// ----------------- VALUES -----------------
value: NUMBER "[" UNIT "]"
     | expr

// ------------- Arithmetic -------------
expr: term (ADD_OP term)*
term: atom (MUL_OP atom)*
atom: NUMBER
    | NAME
    | var
    | "(" expr ")"

ADD_OP: "+" | "-"
MUL_OP: "*" | "/"

var: "{" NAME "}"

UNIT: "Gbps" | "Mbps" | "Kbps" | "GBps" | "MBps" | "KBps" | "ns" | "us" | "ms"

// ----------------- TOKENS -----------------
%import common.CNAME -> NAME
%import common.NUMBER
COMMENT: "//" /[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
